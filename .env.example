# ---------------------------------------------------------------------------
# First Class Parlays — configuration
# Copy this file to apps/api/.env and fill in the values.
# Every line is explained in docs/SETUP.md.
# ---------------------------------------------------------------------------

# Where the database lives. Created for you by the setup script.
DATABASE_URL="postgresql://fcp:fcp@localhost:5432/fcp?schema=public"

# Long random strings that keep sign-ins secure. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

# The web address the app is served from, used for links in notifications.
PUBLIC_APP_URL="http://localhost:5173"

API_PORT=8080

# Where uploaded ticket photos are stored. IMPORTANT once you deploy: most
# hosting platforms erase the filesystem on every redeploy, which would lose
# the ticket images. Attach a persistent volume and point this at it.
# On Railway: add a Volume, mount it at /data, then set UPLOAD_DIR=/data/uploads
UPLOAD_DIR=""


# --- Sports Bet Montana Public Board Reader -------------------------------
# Leave SBM_BOARD_BASE_URL empty until you have written authorization to read
# the public board. With it empty the reader stays switched off and the app
# shows "DATA CURRENTLY UNAVAILABLE" instead of inventing odds.
SBM_BOARD_BASE_URL=""
SBM_READER_ENABLED="false"
# Deliberately slow and low-volume. See docs/SETUP.md before changing these.
SBM_REQUEST_BUDGET_PER_RUN="60"
SBM_MIN_DELAY_MS="10000"
SBM_MAX_DELAY_MS="30000"
SBM_USER_AGENT="FirstClassParlays/1.0 (private group tool; contact: your-email@example.com)"

# --- Optional external data providers -------------------------------------
# Leave blank and the matching feature shows DATA CURRENTLY UNAVAILABLE.
NFL_SCHEDULE_PROVIDER=""
NFL_SCHEDULE_API_KEY=""
NFL_STATS_API_KEY=""
NFL_LIVE_API_KEY=""
INJURY_API_KEY=""
WEATHER_API_KEY=""
NEWS_API_KEY=""
ANTHROPIC_API_KEY=""
OCR_PROVIDER=""
OCR_API_KEY=""
